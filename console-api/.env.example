# SIGDEP-3 hub — console-api environment configuration template.
# Copy to .env and fill in the real values for this environment.

# ----------------------------------------------------------------------------
# Java runtime (REQUIRED — must be JDK 17 or newer)
# run.sh will use this if set; otherwise on macOS it tries
# /usr/libexec/java_home -v 17 and falls back to whatever 'java' is on PATH.
# Examples:
#   macOS Homebrew  : /opt/homebrew/opt/openjdk@17
#   Ubuntu/Debian   : /usr/lib/jvm/java-17-openjdk-amd64
# ----------------------------------------------------------------------------
JAVA_HOME=

# ----------------------------------------------------------------------------
# PostgreSQL (read-mostly access, same database as ingestion-api)
# ----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/sigdep
SPRING_DATASOURCE_USERNAME=sigdep
SPRING_DATASOURCE_PASSWORD=sigdep

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
SERVER_PORT=8081

# ----------------------------------------------------------------------------
# Auth v2.0 (Spring Security + JWT HS256)
# ----------------------------------------------------------------------------
# Clé de signature HS256 — DOIT faire au moins 32 octets. À générer
# aléatoirement et garder secrète (ne jamais committer la vraie valeur).
#   openssl rand -base64 48
SIGDEP_JWT_SECRET=change-me-32-bytes-minimum-secret!!
# Durées de vie (format ISO-8601). Défauts : access 1h, refresh 7j.
#SIGDEP_JWT_ACCESS_TTL=PT1H
#SIGDEP_JWT_REFRESH_TTL=P7D

# Comptes d'administration seedés au démarrage (idempotents par email).
# CHANGER les mots de passe par défaut. Laisser un mot de passe vide
# désactive le seed de ce compte.
SIGDEP_ADMIN_EMAIL=admin@sigdep.ci
SIGDEP_ADMIN_PASSWORD=ChangeMe2026!
#SIGDEP_ADMIN_NAME=Super Administrateur SIGDEP
SIGDEP_IT_ADMIN_EMAIL=it-admin@sigdep.ci
SIGDEP_IT_ADMIN_PASSWORD=ChangeMe2026!
#SIGDEP_IT_ADMIN_NAME=Administrateur Technique SIGDEP

# ----------------------------------------------------------------------------
# Emails transactionnels (réinitialisation / définition de mot de passe,
# bienvenue, notifications). SIGDEP_MAIL_ENABLED=false (défaut) → les emails
# sont LOGUÉS en console au lieu d'être envoyés (test sans SMTP).
# ----------------------------------------------------------------------------
SIGDEP_MAIL_ENABLED=false
SIGDEP_MAIL_FROM=SIGDEP-3 <no-reply@sigdep.ci>
# URL publique du front, base des liens dans les emails.
SIGDEP_PUBLIC_URL=http://localhost:9000
# SMTP (utilisé seulement si SIGDEP_MAIL_ENABLED=true)
SIGDEP_MAIL_HOST=smtp.example.org
SIGDEP_MAIL_PORT=587
SIGDEP_MAIL_USERNAME=
SIGDEP_MAIL_PASSWORD=
# Chiffrement : par défaut STARTTLS (port 587). Pour un SMTP en SSL implicite
# (port 465, fréquent sur cPanel) : SIGDEP_MAIL_STARTTLS=false + SIGDEP_MAIL_SSL=true.
#SIGDEP_MAIL_STARTTLS=true
#SIGDEP_MAIL_SSL=false
# Au besoin, faire confiance au certificat du serveur SMTP (host, ou "*").
#SIGDEP_MAIL_SSL_TRUST=
# TTL des liens (ISO-8601). Reset court, lien de bienvenue plus long.
#SIGDEP_MAIL_RESET_TTL=PT1H
#SIGDEP_MAIL_WELCOME_TTL=PT72H

# ----------------------------------------------------------------------------
# Spring profile
# Leave empty in production. Set to 'dev' only for local development.
# ----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=
