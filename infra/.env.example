# =============================================================================
# Configuration du hub SIGDEP-3 — copier en .env et compléter.
#
# Toutes ces variables sont lues par docker-compose.prod.yml.
# =============================================================================

# ---- Nom de projet Compose (IMPORTANT) ------------------------------------
# Compose préfixe le nom des VOLUMES (postgres_data, superset_home) avec le nom
# de projet. Par défaut ce nom = nom du dossier de déploiement — donc renommer
# ou déplacer le dossier ferait perdre de vue les volumes existants (la base
# semblerait vide). En figeant ce nom ici, les volumes restent rattachés quel
# que soit le dossier : tu peux renommer/déplacer le déploiement sans risque.
# NE PAS le changer sur une instance déjà en service (ses volumes sont sous
# l'ancien préfixe). Pour une instance existante, mettre la valeur au préfixe
# ACTUEL (voir : docker volume ls | grep postgres_data).
COMPOSE_PROJECT_NAME=sigdep-hub

# ---- Postgres (base de données principale du hub) -------------------------
POSTGRES_DB=sigdep
POSTGRES_USER=sigdep
POSTGRES_PASSWORD=changeme

# ---- Auth v2.0 (Spring Security + JWT HS256) ------------------------------
# Clé de signature JWT — DOIT faire au moins 32 octets. À générer
# aléatoirement et garder secrète :  openssl rand -base64 48
SIGDEP_JWT_SECRET=change-me-32-bytes-minimum-secret

# Comptes d'administration seedés au premier démarrage du hub (idempotents
# par email) : un SUPER_ADMIN + un IT_ADMIN. CHANGER les mots de passe.
SIGDEP_ADMIN_EMAIL=admin@sigdep.example.org
SIGDEP_ADMIN_PASSWORD=changeme
SIGDEP_IT_ADMIN_EMAIL=it-admin@sigdep.example.org
SIGDEP_IT_ADMIN_PASSWORD=changeme

# ---- Emails transactionnels -----------------------------------------------
# false → emails logués en console (pas d'envoi). Passer à true et renseigner
# le SMTP pour activer la réinitialisation de mot de passe par email.
SIGDEP_MAIL_ENABLED=false
SIGDEP_MAIL_FROM=SIGDEP-3 <no-reply@sigdep.example.org>
SIGDEP_MAIL_HOST=smtp.example.org
SIGDEP_MAIL_PORT=587
SIGDEP_MAIL_USERNAME=
SIGDEP_MAIL_PASSWORD=
# Par défaut STARTTLS (587). SSL implicite (465, cPanel) :
#   SIGDEP_MAIL_STARTTLS=false  +  SIGDEP_MAIL_SSL=true
#SIGDEP_MAIL_STARTTLS=true
#SIGDEP_MAIL_SSL=false
# Faire confiance au certificat du serveur SMTP (host, ou "*"). Nécessaire pour
# Office365 (sinon « Server is not trusted »). Le FROM doit correspondre au
# compte authentifié (USERNAME), sinon O365 refuse l'envoi (SendAsDenied).
#SIGDEP_MAIL_SSL_TRUST=smtp.office365.com

# ---- URL publique ---------------------------------------------------------
# Origine publique du hub (HTTPS terminé par nginx) — utilisée pour CORS
# et comme base des liens dans les emails.
PUBLIC_ORIGIN=https://sigdep.example.org

# ---- Superset (« Analyses avancées ») -------------------------------------
# Clé secrète Superset — OBLIGATOIRE : openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-superset-secret-key
# Compte admin Superset créé au 1er boot.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_ADMIN_EMAIL=admin@sigdep.example.org
# Rôle PostgreSQL lecture seule créé au 1er boot de la base (laisser le mot de
# passe vide pour ne pas le créer). À utiliser dans Superset comme source :
#   postgresql://superset_ro:<password>@postgres:5432/sigdep
SUPERSET_DB_READONLY_USER=superset_ro
SUPERSET_DB_READONLY_PASSWORD=changeme
# Base + rôle de MÉTADONNÉES Superset (dashboards, état SQL Lab). PostgreSQL au
# lieu de SQLite : indispensable en multi-worker (sinon « Impossible de migrer
# l'état de l'éditeur de requêtes »). Laisser le mot de passe vide retombe sur
# SQLite (déconseillé).
SUPERSET_META_DB=superset_meta
SUPERSET_META_USER=superset_meta
SUPERSET_META_PASSWORD=changeme
# Côté build console-web : VITE_SUPERSET_URL doit pointer vers Superset
# (sous-domaine dédié : https://analytics.sigdep.example.org/).

# ---- SSO Superset (entrée sans re-login depuis la console) ----------------
# La console pose un cookie sur le DOMAINE PARENT, partagé avec le sous-domaine
# Superset. DOIT être le domaine parent commun aux deux (préfixé d'un point) :
#   console = sigdep.example.org  +  superset = analytics.sigdep.example.org
#   → SIGDEP_SSO_COOKIE_DOMAIN=.sigdep.example.org
# Laisser VIDE désactive le SSO (Superset garde son login séparé).
SIGDEP_SSO_COOKIE_DOMAIN=.sigdep.example.org
# Cookie Secure (HTTPS). Garder true en production.
SIGDEP_SSO_COOKIE_SECURE=true

# ---- Images Docker publiées sur GHCR --------------------------------------
# Le workflow release.yml du hub publie ces 3 images à chaque tag v*.*.*.
# Épingler la version voulue (recommandé) ou utiliser :latest.
CONSOLE_API_IMAGE=ghcr.io/itech-ci/sigdep-console-api:1.0.3
INGESTION_API_IMAGE=ghcr.io/itech-ci/sigdep-ingestion-api:1.0.3
CONSOLE_WEB_IMAGE=ghcr.io/itech-ci/sigdep-console-web:1.0.3
