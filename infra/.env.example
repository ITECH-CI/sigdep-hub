# =============================================================================
# Configuration du hub SIGDEP-3 — copier en .env et compléter.
#
# Toutes ces variables sont lues par docker-compose.prod.yml.
# =============================================================================

# ---- Postgres (base de données principale du hub) -------------------------
POSTGRES_DB=sigdep
POSTGRES_USER=sigdep
POSTGRES_PASSWORD=changeme

# ---- Auth v2.0 (Spring Security + JWT HS256) ------------------------------
# Clé de signature JWT — DOIT faire au moins 32 octets. À générer
# aléatoirement et garder secrète :  openssl rand -base64 48
SIGDEP_JWT_SECRET=change-me-32-bytes-minimum-secret

# Comptes d'administration seedés au premier démarrage du hub (idempotents
# par email) : un SUPER_ADMIN + un IT_ADMIN. CHANGER les mots de passe.
SIGDEP_ADMIN_EMAIL=admin@sigdep.example.org
SIGDEP_ADMIN_PASSWORD=changeme
SIGDEP_IT_ADMIN_EMAIL=it-admin@sigdep.example.org
SIGDEP_IT_ADMIN_PASSWORD=changeme

# ---- URL publique ---------------------------------------------------------
# Origine publique du hub (HTTPS terminé par nginx) — utilisée pour CORS.
PUBLIC_ORIGIN=https://sigdep.example.org

# ---- Images Docker publiées sur GHCR --------------------------------------
# Le workflow release.yml du hub publie ces 3 images à chaque tag v*.*.*.
# Épingler la version voulue (recommandé) ou utiliser :latest.
CONSOLE_API_IMAGE=ghcr.io/itech-ci/sigdep-console-api:1.0.3
INGESTION_API_IMAGE=ghcr.io/itech-ci/sigdep-ingestion-api:1.0.3
CONSOLE_WEB_IMAGE=ghcr.io/itech-ci/sigdep-console-web:1.0.3
