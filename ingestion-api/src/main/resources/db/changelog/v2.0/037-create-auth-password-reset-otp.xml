<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="037-create-auth-password-reset-otp" author="itechciv" failOnError="true">
        <createTable tableName="password_reset_otp" schemaName="auth"
                     remarks="OTP 6 chiffres pour le reset de mot de passe (TTL 15 min). Le code brut n'est jamais stocké (BCrypt).">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_password_reset_otp_user"
                             references="auth.users(id)" deleteCascade="true"/>
            </column>
            <column name="otp_hash" type="VARCHAR(255)" remarks="BCrypt du code 6 chiffres">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="password_reset_otp" schemaName="auth" indexName="idx_password_reset_otp_user">
            <column name="user_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="password_reset_otp" schemaName="auth"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
