<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
      Colonnes de mesure DECIMAL de core.visits élargies MASSIVEMENT pour ne
      plus jamais rejeter une valeur, même aberrante.

      Un 2e site a des valeurs hors normes physiologiques (taille manifestement
      saisie en mm, poids à 5 chiffres…) qui débordaient successivement
      DECIMAL(5,2) puis DECIMAL(6,2) puis DECIMAL(4,1) :
        « ERROR: numeric field overflow ».

      Plutôt que d'élargir au coup par coup, on porte toutes ces colonnes à une
      précision très large (10 chiffres) — aucune valeur ne peut plus déborder.
      Les aberrations sont stockées telles quelles et devront être normalisées
      côté analyse ; ce changeset ne fait que débloquer l'ingestion.

      Idempotent (modifyDataType), non destructif. Même approche que la 042.
    -->

    <changeSet id="044-widen-visits-weight-kg" author="pkomena">
        <modifyDataType tableName="visits" schemaName="core"
                        columnName="weight_kg" newDataType="DECIMAL(10,2)"/>
    </changeSet>

    <changeSet id="044-widen-visits-height-cm" author="pkomena">
        <modifyDataType tableName="visits" schemaName="core"
                        columnName="height_cm" newDataType="DECIMAL(10,2)"/>
    </changeSet>

    <changeSet id="044-widen-visits-temperature" author="pkomena">
        <modifyDataType tableName="visits" schemaName="core"
                        columnName="temperature_c" newDataType="DECIMAL(10,1)"/>
    </changeSet>

    <changeSet id="044-widen-visits-bmi" author="pkomena">
        <modifyDataType tableName="visits" schemaName="core"
                        columnName="bmi" newDataType="DECIMAL(10,1)"/>
    </changeSet>

    <changeSet id="044-widen-visits-muac" author="pkomena">
        <modifyDataType tableName="visits" schemaName="core"
                        columnName="mid_upper_arm_circumference" newDataType="DECIMAL(10,1)"/>
    </changeSet>

</databaseChangeLog>
